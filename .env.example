# Export these variables explicitly; the server does not auto-load .env.
# Independent development port, not the Go service port.
PORT=3001
SYNC_FREQUENCY=60
# Used only when SQL_DSN is unset or empty. The file MUST already exist.
SQLITE_PATH=newapi.db
# Optional override; only sqlite:, postgres:, postgresql: are supported.
# SQL_DSN=sqlite:newapi.db
# SQL_DSN=postgresql://test_user:test_password@127.0.0.1:5432/newapi_test
# Never point development/CI at production. No automatic schema migrations.
